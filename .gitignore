# =============================================================================
# Fish Speech - .gitignore
# =============================================================================

# Operating System Files
# -----------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and Editors
# ----------------
.vscode/
.idea/
*.swp
*.swo
*~

# Python
# ------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
# --------------------
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
/fishenv/

# Project Dependencies
# --------------------
.pdm-python
/fish_speech.egg-info

# Data and Model Files
# --------------------
data/
results/
checkpoints/
# references/* (not references/) so git still traverses the directory and
# the preset-voice negation rules below can re-include specific subfolders.
references/*
demo-audios/
example/
filelists/
*.filelist

# Audio Files
# -----------
*.wav
# ...but keep test audio (reference + ai_generated) tracked
!test_audio/**
!test_audio/**/*.wav
*.mp3
!test_audio/**/*.mp3
*.flac
*.ogg
*.m4a

# Data Files
# ----------
*.npy
*.npz
*.pkl
*.pickle
*.lab
/fish_speech/text/cmudict_cache.pickle

# Cache and Temporary Files
# --------------------------
/.cache/
/.gradio/
/.locale/
.pgx.*
*log
*.log
site/

# External Tools
# --------------
ffmpeg.exe
ffprobe.exe
/faster_whisper/

# Server Related
# --------------
/data_server/target/

# Test Files
# ----------
/*.test.sh
asr-label*

# Preset voices (webui_v2 "pick a ready-made voice" picker)
# -----------------------------------------------------------
# references/ is otherwise runtime data (see above), and *.mp3/*.lab are
# ignored globally (see Audio/Data Files above) — override both for these
# specific, checked-in preset folders only.
!references/Amelia Taylor/
!references/Amelia Taylor/**
!references/John Taylor/
!references/John Taylor/**
!references/Ava Thompson/
!references/Ava Thompson/**

# Emotion Presets
# ---------------
!reference_audio/
!reference_audio/**
!reference_audio/**/*.mp3
!reference_audio/**/*.wav
!reference_audio/**/*.flac
!reference_audio/**/*.ogg
