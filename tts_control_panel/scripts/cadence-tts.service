# systemd unit for the Cadence TTS Control Panel.
#
# Install (as root):
#   cp scripts/cadence-tts.service /etc/systemd/system/cadence-tts.service
#   # edit the paths and User= below to match your deployment first
#   systemctl daemon-reload
#   systemctl enable --now cadence-tts
#
# Manage:
#   systemctl start cadence-tts
#   systemctl stop cadence-tts
#   systemctl restart cadence-tts
#   systemctl status cadence-tts
#   journalctl -u cadence-tts -f
#
# See README.md for the full setup (checkpoints, whisper model, venv).

[Unit]
Description=Cadence TTS Control Panel (Fish Speech S2)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/fish-speech/tts_control_panel

# Adjust to the venv/python that has both this app's requirements.txt and
# fish-speech's dependencies installed (see README.md "Setup").
ExecStart=/home/ubuntu/fish-speech/tts_control_panel/.venv/bin/python run_server.py \
    --host 0.0.0.0 \
    --port 8731 \
    --device cuda \
    --llama-checkpoint-path /home/ubuntu/fish-speech/checkpoints/s2-pro \
    --decoder-checkpoint-path /home/ubuntu/fish-speech/checkpoints/s2-pro/codec.pth \
    --whisper-model-dir /home/ubuntu/fish-speech/checkpoints/whisper-small-pt

Restart=on-failure
RestartSec=5
# Model loading (checkpoint read + warmup inference) can take a while on
# first start; give systemd room before it gives up on startup.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
